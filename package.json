{
  "name": "brainiac",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent",
    "dev": "doppler run -- alchemy dev",
    "bench": "node apps/worker/bench/bench.ts",
    "deploy": "doppler run -- alchemy deploy",
    "plan": "doppler run -- alchemy plan",
    "destroy": "doppler run -- alchemy destroy",
    "typecheck": "effect-tsgo tsc -p . && vp run -r typecheck",
    "check:changed": "node scripts/check-changed.ts",
    "knip": "knip",
    "doctor": "node scripts/doctor.ts",
    "dev:sign-in": "node scripts/dev-auth.ts sign-in",
    "dev:token": "node scripts/dev-auth.ts token",
    "e2e": "node scripts/e2e.ts",
    "scenarios:prove": "node scripts/prove-scenario.ts",
    "test:browser": "cd apps/web && vp test run --project browser",
    "eval:answers": "node evals/answers/run.ts",
    "eval:drafts": "node evals/drafts/run.ts",
    "eval:filing": "node evals/filing/run.ts",
    "eval:mcp-tool-use": "node evals/mcp-tool-use/run.ts",
    "eval:photos": "node evals/photos/run.ts",
    "eval:review-detectors": "node evals/review-detectors/run.ts",
    "eval:retrieval": "node evals/retrieval/run.ts",
    "eval:structure": "node evals/structure/run.ts",
    "logs": "node scripts/logs.ts",
    "repos:sync": "node scripts/sync-reference-repos.ts",
    "setup": "node scripts/setup-worktree.ts"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.87",
    "@alchemy.run/neon": "2.0.0-beta.87",
    "@effect/language-service": "0.87.5",
    "@effect/platform-node": "4.1.4",
    "@effect/tsgo": "0.69.0",
    "@oxlint/plugins": "1.93.0",
    "@types/node": "24.19.2",
    "alchemy": "2.0.0-beta.87",
    "effect": "4.1.4",
    "knip": "6.45.1",
    "playwright": "1.64.1",
    "vite-plus": "1.6.0"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.18.0"
}
