{
  "manifest_version": 3,
  "name": "Brainiac",
  "version": "0.1.0",
  "description": "Fill a form your Claude asked for with one click, from your Brainiac vault, only on the site it's saved for.",
  "key": "",
  "minimum_chrome_version": "116",
  "action": { "default_popup": "popup.html", "default_title": "Brainiac" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*"]
}
