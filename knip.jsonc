{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Exported types are part of our contracts before they have consumers.
  "rules": { "types": "off", "nsTypes": "off" },
  // Installed with Homebrew, not npm.
  "ignoreBinaries": ["doppler"],
  "workspaces": {
    ".": {
      // alchemy.run.ts is loaded by the alchemy CLI; scripts and evals run from package.json and t3.json, and
      // scripts/e2e.ts loads each scenario by its file name.
      "entry": ["alchemy.run.ts", "scripts/*.ts", "scripts/scenarios/*.ts", "evals/*/run.ts"],
      "project": ["*.ts", "scripts/**/*.ts", "evals/**/*.ts"],
      // Loaded as a tsconfig plugin, so no import references it.
      "ignoreDependencies": ["@effect/language-service"],
    },
    // workers-types is loaded through tsconfig "types".
    // The engine runners are started by engines.test.ts (and sync's by stores.test.ts) (Bun by path, workerd from a bundle), and Bun is
    // run from its package's binary rather than imported.
    "packages/base": { "entry": ["test/bun.ts", "test/workerd.ts"], "ignoreDependencies": ["bun"] },
    "packages/sync": { "entry": ["test/bun.ts"], "ignoreDependencies": ["bun"] },
    "apps/cli": { "entry": ["test/bun.ts"] },
    // vite is there for its `vite/client` types (tsconfig "types"), which the PDF viewer's `?url` imports need.
    "packages/render": { "ignoreDependencies": ["vite"] },
    // Chrome's types are loaded through tsconfig "types".
    "apps/extension": { "ignoreDependencies": ["@types/chrome"] },
    // TanStack Start loads its routes by file name. The browser test provider is imported through vite-plus's
    // re-export (vite-plus/test/browser-playwright), with playwright as its peer.
    "apps/web": {
      "entry": ["src/routes/**/*.tsx"],
      "ignoreDependencies": ["@vitest/browser-playwright", "playwright"],
    },
    // workers-types is loaded through tsconfig "types"; tests start the Worker through scripts/ocr-worker.ts.
    "apps/ocr": { "ignoreDependencies": ["@cloudflare/workers-types"] },
    // The same for the Typst Worker (scripts/typst-worker.ts).
    "apps/typst": { "ignoreDependencies": ["@cloudflare/workers-types"] },
    // test/harness.ts is bundled into workerd by base.test.ts.
    "apps/worker": {
      "entry": ["src/index.ts", "test/harness.ts"],
      // Bun runs the CLI for the stdio parity test, by path from its package's binary.
      "ignoreDependencies": ["@cloudflare/workers-types", "bun"],
    },
  },
}
